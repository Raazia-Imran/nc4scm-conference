{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-4SeNhJhFi03YKvlYIJoqKFgw7w9BYB6NDkh1m3zJ3EQ='; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action https://formsubmit.co; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "gcgc.nc4scm.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/call-for-papers",
      "destination": "/call-for-papers.html"
    },
    {
      "source": "/programme",
      "destination": "/programme.html"
    },
    {
      "source": "/speakers",
      "destination": "/speakers.html"
    },
    {
      "source": "/registration",
      "destination": "/registration.html"
    },
    {
      "source": "/accommodation",
      "destination": "/accommodation.html"
    },
    {
      "source": "/committees",
      "destination": "/committees.html"
    },
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/archive",
      "destination": "/archive.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "redirects": [
    {
      "source": "/images/sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/call-for-papers.html",
      "destination": "/call-for-papers",
      "permanent": true
    },
    {
      "source": "/programme.html",
      "destination": "/programme",
      "permanent": true
    },
    {
      "source": "/speakers.html",
      "destination": "/speakers",
      "permanent": true
    },
    {
      "source": "/registration.html",
      "destination": "/registration",
      "permanent": true
    },
    {
      "source": "/accommodation.html",
      "destination": "/accommodation",
      "permanent": true
    },
    {
      "source": "/committees.html",
      "destination": "/committees",
      "permanent": true
    },
    {
      "source": "/partners.html",
      "destination": "/partners",
      "permanent": true
    },
    {
      "source": "/archive.html",
      "destination": "/archive",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/cookies.html",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    }
  ]
}
