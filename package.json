  "dependencies": {
    "@vercel/speed-insights": "2.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "framer-motion": "13.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
